@model IEnumerable<Asandului_Oana_Maria_Insurance.Models.Policy>

@{
    ViewData["Title"] = "Policies";
    var providers = ViewData["Providers"] as SelectList;
}

<h1>Policies</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<form method="get" asp-action="Index" class="row g-2 mb-3">
    <div class="col-md-4">
        <label class="form-label">Search Customer</label>
        <input type="text" name="searchCustomer" value="@(ViewData["SearchCustomer"] ?? "")" class="form-control" />
    </div>

    <div class="col-md-4">
        <label class="form-label">Provider</label>
        <select name="providerId" class="form-control" asp-items="providers">
            <option value="" selected="@(ViewData["ProviderId"] == null ? "selected" : null)">All</option>
        </select>

    </div>

    <div class="col-md-4 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Filter</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.PolicyNumber)</th>
            <th>
                <a asp-action="Index"
                   asp-route-searchCustomer="@(ViewData["SearchCustomer"] ?? "")"
                   asp-route-providerId="@(ViewData["ProviderId"] ?? "")"
                   asp-route-sortOrder="@(ViewData["StartSort"] ?? "")">
                    StartDate
                </a>
            </th>
            <th>@Html.DisplayNameFor(model => model.EndDate)</th>
            <th>
                <a asp-action="Index"
                   asp-route-searchCustomer="@(ViewData["SearchCustomer"] ?? "")"
                   asp-route-providerId="@(ViewData["ProviderId"] ?? "")"
                   asp-route-sortOrder="@(ViewData["PremiumSort"] ?? "")">
                    Premium
                </a>
            </th>
            <th>Customer</th>
            <th>Provider</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@Html.DisplayFor(modelItem => item.PolicyNumber)</td>
                <td>@Html.DisplayFor(modelItem => item.StartDate)</td>
                <td>@Html.DisplayFor(modelItem => item.EndDate)</td>
                <td>@Html.DisplayFor(modelItem => item.Premium)</td>
                <td>@(item.Customer?.Name ?? "")</td>
                <td>@(item.Provider?.Name ?? "")</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@item.PolicyID">Edit</a> |
                    <a asp-action="Details" asp-route-id="@item.PolicyID">Details</a> |
                    <a asp-action="Delete" asp-route-id="@item.PolicyID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>
