@model IEnumerable<Asandului_Oana_Maria_Insurance.Models.Claim>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>@Html.DisplayNameFor(model => model.ClaimDate)</th>
            <th>@Html.DisplayNameFor(model => model.Description)</th>
            <th>@Html.DisplayNameFor(model => model.Amount)</th>
            <th>Policy</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model)
{
        <tr>
            <td>@Html.DisplayFor(modelItem => item.ClaimDate)</td>
            <td>@Html.DisplayFor(modelItem => item.Description)</td>
            <td>@Html.DisplayFor(modelItem => item.Amount)</td>
            <td>@(item.Policy?.PolicyNumber ?? "")</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.ClaimID">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ClaimID">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ClaimID">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
