@model Asandului_Oana_Maria_Insurance.Models.ChargesPredictionViewModel

@{
    ViewData["Title"] = "Insurance Charges Prediction";
}

<h1>Insurance Charges Prediction</h1>

<form asp-action="Index" method="post" class="row g-3">
    @Html.AntiForgeryToken()

    <div class="col-md-2">
        <label class="form-label">Age</label>
        <input asp-for="Age" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Sex</label>
        <select asp-for="Sex" class="form-control">
            <option value="female">female</option>
            <option value="male">male</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">BMI</label>
        <input asp-for="Bmi" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Children</label>
        <input asp-for="Children" class="form-control" />
    </div>

    <div class="col-md-2">
        <label class="form-label">Smoker</label>
        <select asp-for="Smoker" class="form-control">
            <option value="true">true</option>
            <option value="false">false</option>
        </select>
    </div>

    <div class="col-md-2">
        <label class="form-label">Region</label>
        <select asp-for="Region" class="form-control">
            <option value="southwest">southwest</option>
            <option value="southeast">southeast</option>
            <option value="northwest">northwest</option>
            <option value="northeast">northeast</option>
        </select>
    </div>

    <div class="col-12">
        <button type="submit" class="btn btn-primary">Predict</button>
    </div>
</form>

@if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
{
    <div class="alert alert-danger mt-3">
        Error: @Model.ErrorMessage
    </div>
}

@if (Model.PredictedCharges.HasValue)
{
    <div class="alert alert-success mt-3">
        <h4 class="mb-0">Predicted charges: @Model.PredictedCharges.Value</h4>
    </div>
}
